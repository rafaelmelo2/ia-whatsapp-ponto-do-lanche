{
  "name": "ponto-do-lanche-bot",
  "version": "2.0.0",
  "description": "Bot WhatsApp SaaS para Ponto do Lanche (Core/Config Arch)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 \"src/**/*.md\" dist",
    "start": "node dist/index.js",
    "dev": "node --no-warnings --loader ts-node/esm/transpile-only src/index.ts",
    "backup": "node --no-warnings --loader ts-node/esm/transpile-only scripts/backup-data.ts",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:prod:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down"
  },
  "dependencies": {
    "@langchain/community": "^1.0.7",
    "@langchain/core": "^1.1.4",
    "@langchain/openai": "^1.1.3",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0",
    "langchain": "^1.1.5",
    "openai": "^4.73.0",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/uuid": "^10.0.0",
    "copyfiles": "^2.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
