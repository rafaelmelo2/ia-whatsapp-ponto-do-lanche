# ============================================================================
# Sirvase — .env de bootstrap (ÚNICA fonte de secrets). Copie para `.env`.
# Config NÃO-secreta vive em config/app/${ENVIRONMENT}.yaml (versionada).
# Seleção de ambiente/ingress por estas duas variáveis:
# ============================================================================
ENVIRONMENT=local            # local | staging | prod
INGRESS_MODE=loopback        # loopback | gateway | edge
DOMAIN=localhost             # usado só no INGRESS_MODE=edge (ACME/TLS automático)

# --- App / serviços ---------------------------------------------------------
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost

# --- Postgres (P0.4) --------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sirvase
POSTGRES_USER=sirvase
POSTGRES_PASSWORD=           # OBRIGATÓRIO — fail-fast no boot se vazio

# --- Redis (P0.4) -----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=              # OBRIGATÓRIO

# --- Auth JWT (Épico 1) -----------------------------------------------------
JWT_SECRET=                  # OBRIGATÓRIO — min 32 chars

# --- Cifra de secrets por tenant (Épico 6) ---------------------------------
ENCRYPTION_KEY=              # 32 bytes (base64) — opcional até Épico 6

# --- LLM via OpenRouter (Épicos 2/5) ---------------------------------------
LLM_API_KEY=                 # OBRIGATÓRIO
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- WhatsApp Cloud API (Épico 4) ------------------------------------------
WHATSAPP_VERIFY_TOKEN=       # você inventa — tem que bater com o painel da Meta (GET de verificação)
WHATSAPP_APP_SECRET=         # valida X-Hub-Signature-256 (validação completa no Épico 4)
WHATSAPP_ACCESS_TOKEN=       # token do painel da Meta (temp 24h ou permanente) — p/ enviar mensagens
WHATSAPP_PHONE_NUMBER_ID=    # Phone number ID do número de teste (não é o telefone)
WHATSAPP_GRAPH_VERSION=v22.0 # versão da Graph API

# --- Evolution API (Épico 4 — provedor ativo agora) ------------------------
EVOLUTION_API_URL=http://evolution:8080     # local: nome do serviço Docker; produção: URL da Evolution na VPS
EVOLUTION_API_KEY=                          # OBRIGATÓRIO p/ rodar Evolution local (AUTHENTICATION_API_KEY dela) e p/ chamar a REST dela
EVOLUTION_WEBHOOK_TOKEN=                     # OBRIGATÓRIO — valida POST /webhook/evolution (ela não assina payload como a Meta)

# --- Billing Asaas (Épico 8) -----------------------------------------------
ASAAS_API_KEY=               # opcional até Épico 8
